-- ----------------------------
-- Table structure for monitor_webhook_log
-- ----------------------------
DROP TABLE IF EXISTS `monitor_webhook_log`;
CREATE TABLE `monitor_webhook_log` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `source` varchar(50) NOT NULL COMMENT '来源标识',
  `title` varchar(200) NOT NULL COMMENT '告警标题',
  `content` text NOT NULL COMMENT '告警内容',
  `level` varchar(20) DEFAULT NULL COMMENT '告警级别',
  `tags` varchar(500) DEFAULT NULL COMMENT '标签(JSON数组字符串)',
  `extra` text COMMENT '额外数据(JSON字符串)',
  `notify_robot_ids` varchar(200) DEFAULT NULL COMMENT '通知的机器人ID列表(逗号分隔)',
  `status` varchar(20) DEFAULT 'success' COMMENT '处理状态(success/failed/partial)',
  `error_msg` text COMMENT '错误信息',
  `notify_count` bigint DEFAULT '0' COMMENT '通知数量',
  `success_count` bigint DEFAULT '0' COMMENT '成功数量',
  `failed_count` bigint DEFAULT '0' COMMENT '失败数量',
  `created_at` datetime(3) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_webhook_log
-- ----------------------------
BEGIN;
INSERT INTO `monitor_webhook_log` (`id`, `source`, `title`, `content`, `level`, `tags`, `extra`, `notify_robot_ids`, `status`, `error_msg`, `notify_count`, `success_count`, `failed_count`, `created_at`) VALUES (1, 'zabbix', 'CPU告警', 'CPU使用率过高', 'critical', '', '', '', 'success', '', 1, 0, 0, '2026-01-08 18:08:01.934');
INSERT INTO `monitor_webhook_log` (`id`, `source`, `title`, `content`, `level`, `tags`, `extra`, `notify_robot_ids`, `status`, `error_msg`, `notify_count`, `success_count`, `failed_count`, `created_at`) VALUES (2, 'prometheus', '服务宕机', 'API服务无响应', 'critical', '', '', '', 'success', '', 1, 0, 0, '2026-01-08 18:08:28.929');
COMMIT;

-- ----------------------------
-- Table structure for monitor_webhook_notify_log
-- ----------------------------
DROP TABLE IF EXISTS `monitor_webhook_notify_log`;
CREATE TABLE `monitor_webhook_notify_log` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `webhook_log_id` bigint NOT NULL COMMENT 'Webhook日志ID',
  `robot_id` bigint NOT NULL COMMENT '机器人ID',
  `robot_name` varchar(100) DEFAULT NULL COMMENT '机器人名称',
  `robot_type` varchar(20) DEFAULT NULL COMMENT '机器人类型',
  `status` varchar(20) NOT NULL COMMENT '发送状态(success/failed)',
  `error_msg` text COMMENT '错误信息',
  `created_at` datetime(3) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_monitor_webhook_notify_log_webhook_log_id` (`webhook_log_id`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_webhook_notify_log
-- ----------------------------
BEGIN;
INSERT INTO `monitor_webhook_notify_log` (`id`, `webhook_log_id`, `robot_id`, `robot_name`, `robot_type`, `status`, `error_msg`, `created_at`) VALUES (1, 1, 1, 'devops飞书机器人', 'feishu', 'success', '', '2026-01-08 18:08:02.660');
INSERT INTO `monitor_webhook_notify_log` (`id`, `webhook_log_id`, `robot_id`, `robot_name`, `robot_type`, `status`, `error_msg`, `created_at`) VALUES (2, 2, 1, 'devops飞书机器人', 'feishu', 'success', '', '2026-01-08 18:08:29.570');
COMMIT;

-- ----------------------------
-- Table structure for notify_robot
-- ----------------------------
DROP TABLE IF EXISTS `notify_robot`;
CREATE TABLE `notify_robot` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(100) NOT NULL COMMENT '机器人名称',
  `type` varchar(20) NOT NULL COMMENT '机器人类型(dingtalk/feishu/wechat)',
  `webhook` varchar(500) NOT NULL COMMENT 'webhook地址',
  `secret` varchar(200) DEFAULT NULL COMMENT '加签密钥',
  `status` tinyint DEFAULT '1' COMMENT '状态(1:启用,0:禁用)',
  `remark` varchar(500) DEFAULT NULL COMMENT '备注说明',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of notify_robot
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for prompt_template
-- ----------------------------
DROP TABLE IF EXISTS `prompt_template`;
CREATE TABLE `prompt_template` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '''主键''',
  `name` varchar(200) NOT NULL COMMENT '''模板名称''',
  `category` varchar(50) NOT NULL COMMENT '''分类:inspection/incident/prediction/general''',
  `scene` varchar(50) NOT NULL COMMENT '''场景:summary/analysis/suggestion/fix''',
  `template` text NOT NULL COMMENT '''模板内容(支持变量替换)''',
  `variables` varchar(1000) DEFAULT NULL COMMENT '''变量列表(JSON数组)''',
  `system_prompt` text COMMENT '''系统提示词''',
  `temperature` decimal(3,2) DEFAULT '0.70' COMMENT '''温度参数''',
  `max_tokens` bigint DEFAULT '2000' COMMENT '''最大Token数''',
  `model_id` bigint unsigned DEFAULT NULL COMMENT '''默认模型ID''',
  `enabled` bigint DEFAULT '1' COMMENT '''是否启用:1=启用,2=禁用''',
  `create_time` datetime(3) NOT NULL COMMENT '''创建时间''',
  `update_time` datetime(3) NOT NULL COMMENT '''更新时间''',
  PRIMARY KEY (`id`),
  UNIQUE KEY `idx_prompt_template_name` (`name`),
  KEY `idx_prompt_template_category` (`category`),
  KEY `idx_prompt_template_scene` (`scene`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of prompt_template
-- ----------------------------
BEGIN;
INSERT INTO `prompt_template` (`id`, `name`, `category`, `scene`, `template`, `variables`, `system_prompt`, `temperature`, `max_tokens`, `model_id`, `enabled`, `create_time`, `update_time`) VALUES (1, 'inspection_summary', 'inspection', 'summary', '你是一个专业的运维工程师，请根据以下巡检结果生成总结报告：\n\n## 巡检信息\n- 主机: {{hostName}} ({{hostIp}})\n- 巡检时间: {{inspectionTime}}\n- 总检查项: {{totalChecks}}\n- 通过项: {{passedChecks}}\n- 失败项: {{failedChecks}}\n- 警告项: {{warnChecks}}\n\n## 检查结果\n{{checkResults}}\n\n请生成一份简洁的总结，包括：\n1. 整体健康状态评估\n2. 主要问题汇总\n3. 风险等级评估\n4. 关键建议（不超过5条）\n\n要求：\n- 简洁专业，重点突出\n- 按优先级排序\n- 给出可执行的建议', '[\"hostName\",\"hostIp\",\"inspectionTime\",\"totalChecks\",\"passedChecks\",\"failedChecks\",\"warnChecks\",\"checkResults\"]', '你是一个专业的运维工程师，擅长分析系统健康状况和提供运维建议。', 0.70, 1000, 0, 1, '2026-01-09 19:16:12.751', '2026-01-09 19:16:12.751');
INSERT INTO `prompt_template` (`id`, `name`, `category`, `scene`, `template`, `variables`, `system_prompt`, `temperature`, `max_tokens`, `model_id`, `enabled`, `create_time`, `update_time`) VALUES (2, 'incident_analysis', 'incident', 'analysis', '你是一个专业的运维故障分析专家，请根据以下信息进行根因分析：\n\n## 故障基本信息\n- 主机: {{hostName}} ({{hostIp}})\n- 故障类别: {{category}}\n- 检测时间: {{detectTime}}\n- 症状: {{symptoms}}\n\n## 证据数据\n{{evidenceData}}\n\n## 分析要求\n1. 分析故障的根本原因\n2. 列出支持该结论的关键证据\n3. 评估故障的影响范围\n4. 给出详细的解决方案\n5. 提供可执行的修复脚本（如适用）\n6. 评估自动修复的风险等级（0-3）\n\n请按照以下JSON格式返回分析结果：\n{\n    \"rootCause\": \"根因描述\",\n    \"keyEvidence\": [\"证据1\", \"证据2\"],\n    \"impact\": \"影响范围描述\",\n    \"solution\": \"解决方案描述\",\n    \"fixScript\": \"#!/bin/bash\\n修复脚本\",\n    \"riskLevel\": 0-3,\n    \"riskReason\": \"风险评估说明\"\n}', '[\"hostName\",\"hostIp\",\"category\",\"detectTime\",\"symptoms\",\"evidenceData\"]', '你是一个专业的运维故障分析专家，擅长快速定位问题根因并提供解决方案。', 0.50, 2000, 0, 1, '2026-01-09 19:16:13.063', '2026-01-09 19:16:13.063');
INSERT INTO `prompt_template` (`id`, `name`, `category`, `scene`, `template`, `variables`, `system_prompt`, `temperature`, `max_tokens`, `model_id`, `enabled`, `create_time`, `update_time`) VALUES (3, 'prediction_suggestion', 'prediction', 'suggestion', '你是一个专业的运维容量规划专家，请根据以下信息给出优化建议：\n\n## 资源信息\n- 目标: {{targetName}}\n- 指标: {{metricName}} ({{metricType}})\n- 当前值: {{currentValue}}%\n- 阈值: {{threshold}}%\n\n## 趋势分析\n- 趋势类型: {{trendType}}\n- 变化率: {{changeRate}}%/天\n- 预测剩余天数: {{daysLeft}}天\n- 置信度: {{confidence}}%\n\n## 预测数据\n未来7天预测值: {{predictions}}\n\n## 要求\n请给出以下建议：\n1. 当前资源状态评估\n2. 风险分析和影响评估\n3. 具体的优化措施（优先级排序）\n4. 扩容建议（如需要）\n5. 成本优化建议\n6. 长期优化策略\n\n请用简洁、专业的语言回答，重点突出可执行的建议。', '[\"targetName\",\"metricName\",\"metricType\",\"currentValue\",\"threshold\",\"trendType\",\"changeRate\",\"daysLeft\",\"confidence\",\"predictions\"]', '你是一个专业的运维容量规划专家，擅长资源趋势分析和容量规划。', 0.70, 1500, 0, 1, '2026-01-09 19:16:13.383', '2026-01-09 19:16:13.383');
COMMIT;

-- ----------------------------
-- Table structure for quick_deployment_tasks
-- ----------------------------
DROP TABLE IF EXISTS `quick_deployment_tasks`;
CREATE TABLE `quick_deployment_tasks` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `deployment_id` bigint unsigned NOT NULL,
  `app_id` bigint unsigned NOT NULL,
  `app_name` varchar(255) DEFAULT NULL,
  `app_code` varchar(255) DEFAULT NULL,
  `environment` varchar(50) DEFAULT NULL,
  `jenkins_env_id` bigint unsigned NOT NULL,
  `jenkins_job_url` varchar(500) DEFAULT NULL,
  `build_number` bigint DEFAULT NULL,
  `status` tinyint DEFAULT '1',
  `execute_order` bigint NOT NULL,
  `start_time` datetime(3) DEFAULT NULL,
  `end_time` datetime(3) DEFAULT NULL,
  `duration` bigint DEFAULT NULL,
  `error_message` text,
  `log_url` varchar(500) DEFAULT NULL,
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  `parameters` text,
  PRIMARY KEY (`id`),
  KEY `idx_quick_deployment_tasks_deployment_id` (`deployment_id`),
  KEY `fk_quick_deployment_tasks_application` (`app_id`),
  KEY `fk_quick_deployment_tasks_jenkins_env` (`jenkins_env_id`),
  CONSTRAINT `fk_quick_deployment_tasks_application` FOREIGN KEY (`app_id`) REFERENCES `app_application` (`id`),
  CONSTRAINT `fk_quick_deployment_tasks_jenkins_env` FOREIGN KEY (`jenkins_env_id`) REFERENCES `app_jenkins_env` (`id`) ON DELETE CASCADE,
  CONSTRAINT `fk_quick_deployments_tasks` FOREIGN KEY (`deployment_id`) REFERENCES `quick_deployments` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=45 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of quick_deployment_tasks
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for quick_deployments
-- ----------------------------
DROP TABLE IF EXISTS `quick_deployments`;
CREATE TABLE `quick_deployments` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(255) NOT NULL,
  `business_group_id` bigint unsigned NOT NULL,
  `business_dept_id` bigint unsigned NOT NULL,
  `description` text,
  `status` tinyint DEFAULT '1',
  `task_count` bigint NOT NULL DEFAULT '0',
  `creator_id` bigint unsigned NOT NULL,
  `creator_name` varchar(100) DEFAULT NULL,
  `start_time` datetime(3) DEFAULT NULL,
  `end_time` datetime(3) DEFAULT NULL,
  `duration` bigint DEFAULT NULL,
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  `execution_mode` tinyint DEFAULT '1',
  `notice` tinyint DEFAULT '0',
  `robot_id` bigint unsigned DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=35 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of quick_deployments
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for redis_instance
-- ----------------------------
DROP TABLE IF EXISTS `redis_instance`;
CREATE TABLE `redis_instance` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '''主键''',
  `code` varchar(36) NOT NULL COMMENT '''实例编码''',
  `name` varchar(100) NOT NULL COMMENT '''实例名称''',
  `mode` varchar(20) NOT NULL COMMENT '''模式:standalone,cluster,sentinel''',
  `host` varchar(300) NOT NULL COMMENT '''主机: standalone为host:port, cluster为逗号分隔, sentinel为master=hosts''',
  `port` bigint DEFAULT '0' COMMENT '''端口(standalone可用)''',
  `db` bigint DEFAULT '0' COMMENT '''默认库号''',
  `username` varchar(100) DEFAULT NULL COMMENT '''用户名(可选)''',
  `password` varchar(500) NOT NULL COMMENT '''密码(加密)''',
  `redis_node_password` varchar(500) DEFAULT '' COMMENT '''节点密码(仅sentinel)''',
  `remark` varchar(500) DEFAULT NULL COMMENT '''备注''',
  `ssh_tunnel_machine_id` bigint unsigned DEFAULT '0' COMMENT '''SSH隧道机器ID''',
  `status` bigint DEFAULT '1' COMMENT '''状态:1->启用,2->禁用''',
  `create_time` datetime(3) NOT NULL COMMENT '''创建时间''',
  `update_time` datetime(3) DEFAULT NULL COMMENT '''更新时间''',
  `creator` varchar(64) DEFAULT NULL COMMENT '''创建人''',
  `creator_id` bigint unsigned DEFAULT NULL COMMENT '''创建人ID''',
  `modifier` varchar(64) DEFAULT NULL COMMENT '''修改人''',
  `modifier_id` bigint unsigned DEFAULT NULL COMMENT '''修改人ID''',
  PRIMARY KEY (`id`),
  UNIQUE KEY `idx_redis_instance_code` (`code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of redis_instance
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for sys_activity_log
-- ----------------------------
DROP TABLE IF EXISTS `sys_activity_log`;
CREATE TABLE `sys_activity_log` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `activity_type` bigint NOT NULL COMMENT '''动态类型：1=密钥同步，2=域名检查，3=服务器巡检，4=定时任务，5=其他''',
  `title` varchar(200) NOT NULL COMMENT '''动态标题''',
  `content` text COMMENT '''动态详细内容''',
  `status` bigint NOT NULL DEFAULT '1' COMMENT '''状态：1=成功，2=失败，3=部分成功''',
  `related_id` bigint unsigned DEFAULT NULL COMMENT '''关联ID（如同步任务ID、域名ID等）''',
  `summary` varchar(500) DEFAULT NULL COMMENT '''摘要信息''',
  `duration` bigint DEFAULT NULL COMMENT '''执行耗时（秒）''',
  `create_time` datetime(3) NOT NULL COMMENT '''创建时间''',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=112 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of sys_activity_log
-- ----------------------------
BEGIN;
INSERT INTO `sys_activity_log` (`id`, `activity_type`, `title`, `content`, `status`, `related_id`, `summary`, `duration`, `create_time`) VALUES (1, 1, '阿里云主机同步', '[2025-12-26 23:31:00] 开始同步\n\n未知云厂商(13):\n未配置密钥\n\n[2025-12-26 23:31:00] 同步完成，耗时: 183.355564ms\n', 1, 6, '同步1个云厂商类型的密钥', 183, '2025-12-26 23:31:00.555');
