-- ----------------------------
-- Table structure for monitor_alert_rule
-- ----------------------------
DROP TABLE IF EXISTS `monitor_alert_rule`;
CREATE TABLE `monitor_alert_rule` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(200) NOT NULL COMMENT '规则名称',
  `description` varchar(500) DEFAULT NULL COMMENT '规则描述',
  `target_type` varchar(20) NOT NULL COMMENT '监控类型(host/service/custom)',
  `target_ids` text COMMENT '监控目标ID列表(JSON数组,如[1,2,3])',
  `prom_ql` text NOT NULL COMMENT 'Prometheus查询表达式',
  `duration` bigint DEFAULT '60' COMMENT '持续时间(秒),触发后持续此时间才告警',
  `metric_name` varchar(100) DEFAULT NULL COMMENT '指标名称(cpu/memory/disk等)',
  `operator` varchar(10) DEFAULT NULL COMMENT '比较运算符(>/</>=/<=/==/!=)',
  `threshold` decimal(10,2) DEFAULT NULL COMMENT '阈值',
  `severity` tinyint DEFAULT '2' COMMENT '告警级别(1:critical,2:warning,3:info)',
  `robot_ids` text COMMENT '通知机器人ID列表(JSON数组)',
  `silence_period` bigint DEFAULT '300' COMMENT '静默期(秒),同一告警在此期间不重复发送',
  `repeat_interval` bigint DEFAULT '3600' COMMENT '重复通知间隔(秒),0表示不重复通知',
  `max_notify_count` bigint DEFAULT '3' COMMENT '最大通知次数,0表示不限制',
  `send_recovery` tinyint DEFAULT '1' COMMENT '是否发送恢复通知',
  `recover_duration` bigint DEFAULT '60' COMMENT '恢复判定时间(秒),持续正常此时间后发送恢复通知',
  `cron_pattern` varchar(100) DEFAULT '@every 30s' COMMENT '调度表达式(cron格式)',
  `append_tags` text COMMENT '附加标签(JSON数组,如["env=prod","team=ops"])',
  `annotations` text COMMENT '注解信息(JSON对象,如{"summary":"CPU告警"})',
  `status` tinyint DEFAULT '0' COMMENT '状态(1:启用,0:禁用)',
  `group_id` bigint DEFAULT '0' COMMENT '业务组ID',
  `group_name` varchar(100) DEFAULT NULL COMMENT '业务组名称',
  `created_by` varchar(100) DEFAULT NULL COMMENT '创建人',
  `updated_by` varchar(100) DEFAULT NULL COMMENT '更新人',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `idx_name` (`name`),
  KEY `idx_monitor_alert_rule_target_type` (`target_type`),
  KEY `idx_monitor_alert_rule_status` (`status`),
  KEY `idx_monitor_alert_rule_group_id` (`group_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_alert_rule
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for monitor_alert_rule_template
-- ----------------------------
DROP TABLE IF EXISTS `monitor_alert_rule_template`;
CREATE TABLE `monitor_alert_rule_template` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(200) NOT NULL COMMENT '指标名称,如CPU使用率',
  `description` varchar(500) DEFAULT NULL COMMENT '指标描述',
  `category` varchar(50) NOT NULL COMMENT '数据类型(cpu/memory/load/disk/io/network/connection/service)',
  `prom_ql` text NOT NULL COMMENT 'Prometheus查询表达式',
  `duration` bigint DEFAULT '60' COMMENT '持续时间(秒),触发后持续此时间才告警',
  `metric_name` varchar(100) DEFAULT NULL COMMENT '指标名称',
  `operator` varchar(10) DEFAULT NULL COMMENT '比较运算符(>/</>=/<=/==/!=)',
  `threshold` decimal(10,2) DEFAULT NULL COMMENT '默认阈值',
  `unit` varchar(20) DEFAULT NULL COMMENT '单位(percentage/string/number/bit/GB/MB/byte)',
  `severity` tinyint DEFAULT '2' COMMENT '告警级别(1:critical,2:warning,3:info)',
  `recover_duration` bigint DEFAULT '60' COMMENT '恢复判定时间(秒)',
  `tags` text COMMENT '标签(JSON数组,如["基础监控","资源告警"])',
  `status` tinyint DEFAULT '1' COMMENT '状态(1:启用,0:禁用)',
  `is_builtin` tinyint DEFAULT '0' COMMENT '是否内置模板',
  `created_by` varchar(100) DEFAULT NULL COMMENT '创建人',
  `updated_by` varchar(100) DEFAULT NULL COMMENT '更新人',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  `metric_key` varchar(100) NOT NULL COMMENT '指标项,如system_cpu_usage_percent',
  `value_type` varchar(20) DEFAULT 'number' COMMENT '值类型(number/string/boolean)',
  PRIMARY KEY (`id`),
  UNIQUE KEY `idx_monitor_alert_rule_template_metric_key` (`metric_key`),
  KEY `idx_monitor_alert_rule_template_category` (`category`)
) ENGINE=InnoDB AUTO_INCREMENT=31 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

