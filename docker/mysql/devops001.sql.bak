-- ----------------------------
-- Table structure for k8s_cluster
-- ----------------------------
DROP TABLE IF EXISTS `k8s_cluster`;
CREATE TABLE `k8s_cluster` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '''主键ID''',
  `name` varchar(100) NOT NULL COMMENT '''集群名称''',
  `version` varchar(50) NOT NULL COMMENT '''集群版本''',
  `status` bigint NOT NULL DEFAULT '1' COMMENT '''集群状态:1-创建中,2-运行中,3-离线''',
  `credential` text COMMENT '''集群凭证(kubeconfig)''',
  `description` text COMMENT '''集群描述''',
  `cluster_type` bigint NOT NULL DEFAULT '1' COMMENT '''集群类型:1-自建,2-导入''',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  `node_count` bigint DEFAULT '0' COMMENT '''节点数量''',
  `ready_nodes` bigint DEFAULT '0' COMMENT '''就绪节点数''',
  `master_nodes` bigint DEFAULT '0' COMMENT '''Master节点数''',
  `worker_nodes` bigint DEFAULT '0' COMMENT '''Worker节点数''',
  `last_sync_at` datetime(3) DEFAULT NULL COMMENT '''最后同步时间''',
  PRIMARY KEY (`id`),
  UNIQUE KEY `idx_k8s_cluster_name` (`name`)
) ENGINE=InnoDB AUTO_INCREMENT=36 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of k8s_cluster
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for knowledge_base
-- ----------------------------
DROP TABLE IF EXISTS `knowledge_base`;
CREATE TABLE `knowledge_base` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '''主键''',
  `type` varchar(50) NOT NULL COMMENT '''类型:command/solution/best-practice/faq''',
  `category` varchar(50) NOT NULL COMMENT '''分类''',
  `title` varchar(500) NOT NULL COMMENT '''标题''',
  `content` text NOT NULL COMMENT '''内容''',
  `keywords` varchar(1000) DEFAULT NULL COMMENT '''关键词(JSON数组)''',
  `tags` varchar(500) DEFAULT NULL COMMENT '''标签(JSON数组)''',
  `score` decimal(3,2) DEFAULT '0.50' COMMENT '''评分''',
  `use_count` bigint DEFAULT '0' COMMENT '''使用次数''',
  `enabled` bigint DEFAULT '1' COMMENT '''是否启用:1=启用,2=禁用''',
  `create_time` datetime(3) NOT NULL COMMENT '''创建时间''',
  `update_time` datetime(3) NOT NULL COMMENT '''更新时间''',
  PRIMARY KEY (`id`),
  KEY `idx_knowledge_base_type` (`type`),
  KEY `idx_knowledge_base_category` (`category`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of knowledge_base
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for monitor_agent
-- ----------------------------
DROP TABLE IF EXISTS `monitor_agent`;
CREATE TABLE `monitor_agent` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '''主键''',
  `host_id` bigint unsigned NOT NULL COMMENT '''主机ID''',
  `host_name` longtext COMMENT '''主机名称''',
  `version` varchar(191) DEFAULT '1.0.0' COMMENT '''Agent版本''',
  `status` bigint DEFAULT NULL COMMENT '''状态:1->部署中,2->部署失败,3->运行中,4->已停止''',
  `install_path` longtext COMMENT '''安装路径''',
  `port` bigint DEFAULT '12580' COMMENT '''监听端口''',
  `pid` bigint DEFAULT NULL COMMENT '''进程ID''',
  `last_heartbeat` datetime(3) DEFAULT NULL COMMENT '''最后心跳时间''',
  `update_time` datetime(3) DEFAULT NULL COMMENT '''更新时间''',
  `create_time` datetime(3) NOT NULL COMMENT '''创建时间''',
  `error_msg` text COMMENT '''错误信息''',
  `install_progress` bigint DEFAULT '0' COMMENT '''安装进度(0-100)''',
  PRIMARY KEY (`id`),
  KEY `idx_monitor_agent_host_id` (`host_id`)
) ENGINE=InnoDB AUTO_INCREMENT=200 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_agent
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for monitor_alert_mute
-- ----------------------------
DROP TABLE IF EXISTS `monitor_alert_mute`;
CREATE TABLE `monitor_alert_mute` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(200) NOT NULL COMMENT '静默名称',
  `rule_ids` text COMMENT '规则ID列表(JSON数组),为空表示全局',
  `target_type` varchar(20) DEFAULT NULL COMMENT '目标类型',
  `target_ids` text COMMENT '目标ID列表(JSON数组)',
  `label_matchers` text COMMENT '标签匹配器(JSON数组)',
  `start_time` datetime(3) DEFAULT NULL COMMENT '开始时间',
  `end_time` datetime(3) DEFAULT NULL COMMENT '结束时间',
  `periodic` tinyint DEFAULT '0' COMMENT '是否周期性静默',
  `period_days` varchar(50) DEFAULT NULL COMMENT '周期天数(如1,2,3表示周一到周三)',
  `period_start` varchar(10) DEFAULT NULL COMMENT '每天开始时间(如09:00)',
  `period_end` varchar(10) DEFAULT NULL COMMENT '每天结束时间(如18:00)',
  `status` tinyint DEFAULT '1' COMMENT '状态(1:启用,0:禁用)',
  `remark` varchar(500) DEFAULT NULL COMMENT '备注',
  `created_by` varchar(100) DEFAULT NULL COMMENT '创建人',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_monitor_alert_mute_end_time` (`end_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_alert_mute
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for monitor_alert_policy
-- ----------------------------
DROP TABLE IF EXISTS `monitor_alert_policy`;
CREATE TABLE `monitor_alert_policy` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(200) NOT NULL COMMENT '策略名称',
  `description` varchar(500) DEFAULT NULL COMMENT '策略描述',
  `group_id` bigint NOT NULL COMMENT '业务组ID',
  `group_name` varchar(100) DEFAULT NULL COMMENT '业务组名称',
  `template_ids` text NOT NULL COMMENT '规则模板ID列表(JSON数组,如[1,2,3])',
  `rule_count` bigint DEFAULT '0' COMMENT '规则数量',
  `robot_ids` text COMMENT '通知机器人ID列表(JSON数组)',
  `silence_period` bigint DEFAULT '300' COMMENT '静默时间(秒)',
  `repeat_interval` bigint DEFAULT '600' COMMENT '重复通知间隔(秒),0表示不重复通知',
  `max_notify_count` bigint DEFAULT '10' COMMENT '最大通知次数',
  `send_recovery` tinyint DEFAULT '1' COMMENT '是否发送恢复通知',
  `cron_pattern` varchar(100) DEFAULT '@every 30s' COMMENT '调度表达式',
  `status` tinyint DEFAULT '0' COMMENT '状态(1:启用,0:禁用)',
  `append_tags` text COMMENT '附加标签(JSON数组)',
  `created_by` varchar(100) DEFAULT NULL COMMENT '创建人',
  `updated_by` varchar(100) DEFAULT NULL COMMENT '更新人',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  `health_status` varchar(20) DEFAULT 'healthy' COMMENT '实时健康状态(healthy:健康,alerting:告警中)',
  PRIMARY KEY (`id`),
  UNIQUE KEY `idx_name` (`name`),
  KEY `idx_monitor_alert_policy_group_id` (`group_id`),
  KEY `idx_monitor_alert_policy_status` (`status`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_alert_policy
-- ----------------------------
BEGIN;
INSERT INTO `monitor_alert_policy` (`id`, `name`, `description`, `group_id`, `group_name`, `template_ids`, `rule_count`, `robot_ids`, `silence_period`, `repeat_interval`, `max_notify_count`, `send_recovery`, `cron_pattern`, `status`, `append_tags`, `created_by`, `updated_by`, `created_at`, `updated_at`, `health_status`) VALUES (4, 'autoops', '', 67, '', '', 0, '[1]', 300, 600, 10, 1, '@every 30s', 0, 'bline=ops', '', '', '2026-03-23 13:44:02.563', '2026-03-23 14:30:00.837', 'healthy');
COMMIT;

-- ----------------------------
-- Table structure for monitor_alert_policy_rule
-- ----------------------------
DROP TABLE IF EXISTS `monitor_alert_policy_rule`;
CREATE TABLE `monitor_alert_policy_rule` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `policy_id` bigint NOT NULL COMMENT '策略ID',
  `template_id` bigint NOT NULL COMMENT '规则模板ID',
  `rule_name` varchar(200) NOT NULL COMMENT '规则名称',
  `category` varchar(50) DEFAULT NULL COMMENT '数据类型',
  `metric_key` varchar(100) DEFAULT NULL COMMENT '指标项',
  `unit` varchar(20) DEFAULT NULL COMMENT '单位',
  `operator` varchar(10) NOT NULL COMMENT '比较运算符(>/</>=/<=/==/!=)',
  `threshold` decimal(10,2) NOT NULL COMMENT '阈值',
  `prom_ql` text NOT NULL COMMENT 'Prometheus查询表达式',
  `severity` tinyint DEFAULT '2' COMMENT '告警级别(1:critical,2:warning,3:info)',
  `duration` bigint DEFAULT '60' COMMENT '持续时间(秒),持续多久才告警',
  `continuous_times` bigint DEFAULT '1' COMMENT '持续次数,连续触发多少次才告警',
  `recover_duration` bigint DEFAULT '60' COMMENT '恢复判定时间(秒)',
  `status` tinyint DEFAULT '1' COMMENT '规则是否生效(1:生效,0:不生效)',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  `description` varchar(500) DEFAULT NULL COMMENT '规则描述',
  `health_status` varchar(20) DEFAULT 'healthy' COMMENT '实时健康状态(healthy:健康,alerting:告警中)',
  PRIMARY KEY (`id`),
  KEY `idx_monitor_alert_policy_rule_policy_id` (`policy_id`),
  KEY `idx_monitor_alert_policy_rule_template_id` (`template_id`)
) ENGINE=InnoDB AUTO_INCREMENT=14 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_alert_policy_rule
-- ----------------------------
BEGIN;
INSERT INTO `monitor_alert_policy_rule` (`id`, `policy_id`, `template_id`, `rule_name`, `category`, `metric_key`, `unit`, `operator`, `threshold`, `prom_ql`, `severity`, `duration`, `continuous_times`, `recover_duration`, `status`, `created_at`, `updated_at`, `description`, `health_status`) VALUES (13, 4, 2, 'autoops-内存使用率', 'memory', 'system_memory_usage_percent', '%', '>=', 80.00, 'system_memory_usage_percent{group_id=\"67\"}', 2, 30, 2, 60, 1, '2026-03-23 13:50:08.124', '2026-03-23 14:30:00.584', 'ops', 'healthy');
COMMIT;

-- ----------------------------
-- Table structure for monitor_alert_record
-- ----------------------------
DROP TABLE IF EXISTS `monitor_alert_record`;
CREATE TABLE `monitor_alert_record` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `rule_id` bigint NOT NULL COMMENT '告警规则ID(模板实例ID)',
  `rule_name` varchar(200) DEFAULT NULL COMMENT '规则名称',
  `target_type` varchar(20) DEFAULT NULL COMMENT '监控类型',
  `target_id` bigint DEFAULT NULL COMMENT '目标ID',
  `target_name` varchar(200) DEFAULT NULL COMMENT '目标名称',
  `metric_name` varchar(100) DEFAULT NULL COMMENT '指标名称',
  `current_value` decimal(10,2) DEFAULT NULL COMMENT '当前值',
  `threshold` decimal(10,2) DEFAULT NULL COMMENT '阈值',
  `severity` tinyint DEFAULT NULL COMMENT '告警级别(1:critical,2:warning,3:info)',
  `message` text COMMENT '告警消息',
  `labels` text COMMENT '标签信息(JSON对象)',
  `status` varchar(20) DEFAULT 'firing' COMMENT '告警状态(firing:触发中,resolved:已恢复,acknowledged:已认领)',
  `start_time` datetime(3) DEFAULT NULL COMMENT '开始时间',
  `end_time` datetime(3) DEFAULT NULL COMMENT '结束时间',
  `duration` bigint DEFAULT NULL COMMENT '持续时间(秒)',
  `notify_sent` tinyint DEFAULT '0' COMMENT '是否已发送通知',
  `notify_time` datetime(3) DEFAULT NULL COMMENT '通知时间',
  `notify_count` bigint DEFAULT '0' COMMENT '通知次数',
  `notify_error` text COMMENT '通知错误信息',
  `group_id` bigint DEFAULT '0' COMMENT '业务组ID',
  `group_name` varchar(100) DEFAULT NULL COMMENT '业务组名称',
  `fingerprint` varchar(64) DEFAULT NULL COMMENT '事件指纹(MD5)',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  `policy_id` bigint DEFAULT NULL COMMENT '告警策略ID',
  `policy_name` varchar(200) DEFAULT NULL COMMENT '策略名称',
  `template_id` bigint DEFAULT NULL COMMENT '规则模板ID',
  `summary` varchar(500) DEFAULT NULL COMMENT '告警摘要',
  `handler` varchar(100) DEFAULT NULL COMMENT '处理人',
  `handle_time` datetime(3) DEFAULT NULL COMMENT '处理时间',
  `handle_note` text COMMENT '处理备注',
  PRIMARY KEY (`id`),
  UNIQUE KEY `idx_monitor_alert_record_fingerprint` (`fingerprint`),
  KEY `idx_rule_target` (`rule_id`,`target_id`),
  KEY `idx_monitor_alert_record_target_type` (`target_type`),
  KEY `idx_monitor_alert_record_metric_name` (`metric_name`),
  KEY `idx_monitor_alert_record_severity` (`severity`),
  KEY `idx_monitor_alert_record_status` (`status`),
  KEY `idx_monitor_alert_record_start_time` (`start_time`),
  KEY `idx_monitor_alert_record_group_id` (`group_id`),
  KEY `idx_monitor_alert_record_policy_id` (`policy_id`),
  KEY `idx_monitor_alert_record_template_id` (`template_id`)
) ENGINE=InnoDB AUTO_INCREMENT=90 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_alert_record
-- ----------------------------
BEGIN;
INSERT INTO `monitor_alert_record` (`id`, `rule_id`, `rule_name`, `target_type`, `target_id`, `target_name`, `metric_name`, `current_value`, `threshold`, `severity`, `message`, `labels`, `status`, `start_time`, `end_time`, `duration`, `notify_sent`, `notify_time`, `notify_count`, `notify_error`, `group_id`, `group_name`, `fingerprint`, `created_at`, `updated_at`, `policy_id`, `policy_name`, `template_id`, `summary`, `handler`, `handle_time`, `handle_note`) VALUES (86, 13, 'autoops-内存使用率', 'host', 721, 'hw-ops (172.31.6.35)', 'system_memory_usage_percent', 80.03, 80.00, 2, '【警告】autoops-内存使用率 🔥🔥\n【策略】: autoops\n【规则】: autoops-内存使用率\n【目标】: hw-ops (172.31.6.35)\n【指标】: system_memory_usage_percent\n【运算符】: >=\n【阈值】: 80.00%\n【当前值】: 80.45%\n【时间】: 2026-03-23 13:51:26\n【描述】: ops', '{\"__name__\":\"system_memory_usage_percent\",\"category\":\"memory\",\"group_id\":\"67\",\"group_name\":\"\",\"hostname\":\"hw-ops\",\"instance\":\"172.31.6.35\",\"job\":\"172.31.6.35\",\"operator\":\"\\u003e=\",\"policy_id\":\"4\",\"policy_name\":\"autoops\",\"rule_id\":\"13\",\"rule_name\":\"autoops-内存使用率\",\"severity\":\"2\"}', 'resolved', '2026-03-23 13:51:26.972', '2026-03-23 14:12:56.727', 1289, 0, NULL, 0, '', 67, '', '8d8a823fb69e6ae5113594cde9327d4d_resolved_1774246376974924000', '2026-03-23 13:51:27.024', '2026-03-23 14:12:57.034', 4, 'autoops', 0, '', '', NULL, '');
INSERT INTO `monitor_alert_record` (`id`, `rule_id`, `rule_name`, `target_type`, `target_id`, `target_name`, `metric_name`, `current_value`, `threshold`, `severity`, `message`, `labels`, `status`, `start_time`, `end_time`, `duration`, `notify_sent`, `notify_time`, `notify_count`, `notify_error`, `group_id`, `group_name`, `fingerprint`, `created_at`, `updated_at`, `policy_id`, `policy_name`, `template_id`, `summary`, `handler`, `handle_time`, `handle_note`) VALUES (88, 13, 'autoops-内存使用率', 'host', 721, 'hw-ops (172.31.6.35)', 'system_memory_usage_percent', 80.52, 80.00, 2, '【警告】autoops-内存使用率 🔥🔥\n【策略】: autoops\n【规则】: autoops-内存使用率\n【目标】: hw-ops (172.31.6.35)\n【指标】: system_memory_usage_percent\n【运算符】: >=\n【阈值】: 80.00%\n【当前值】: 80.49%\n【时间】: 2026-03-23 14:13:56\n【描述】: ops', '{\"__name__\":\"system_memory_usage_percent\",\"category\":\"memory\",\"group_id\":\"67\",\"group_name\":\"\",\"hostname\":\"hw-ops\",\"instance\":\"172.31.6.35\",\"job\":\"172.31.6.35\",\"operator\":\"\\u003e=\",\"policy_id\":\"4\",\"policy_name\":\"autoops\",\"rule_id\":\"13\",\"rule_name\":\"autoops-内存使用率\",\"severity\":\"2\"}', 'resolved', '2026-03-23 14:13:56.958', '2026-03-23 14:30:00.073', 963, 1, '2026-03-23 14:13:58.614', 1, '', 67, '', '8d8a823fb69e6ae5113594cde9327d4d_resolved_1774247400283505810', '2026-03-23 14:13:57.007', '2026-03-23 14:30:00.333', 4, 'autoops', 0, '', '', NULL, '');
