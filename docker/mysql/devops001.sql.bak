INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (527, 1, 'gin-api', 'monitor_notify_robot', 3, 'UPDATE monitor_notify_robot \nSET template = \'【{{if .IsRecovered}}警告{{else}}警告{{end}}】${rule_name}{{if .IsRecovered}}告警恢复 ✨✨✨{{else}}告警 🔥 🔥 🔥{{end}}\n【策略】: ${policy_name}\n【规则】: ${rule_name}\n【目标】: ${target_name}\n【指标】: ${metric_name}\n【当前值】: ${current_value}\n【阈值】: ${threshold}\n【时间】: ${first_trigger_time_format}\n【描述】: ${rule_name}\'\nWHERE type = \'feishu\';', '', '', 1, '执行成功', 736, '2026-01-29 18:14:37.379', '', 0);
