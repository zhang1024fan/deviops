INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (481, 1, 'gin-api', 'app_sh_release', 5, '-- 上线趋势统计调试SQL -- 用于排查为什么最新的发布记录没有被统计到 -- =========================================== -- 1. 检查脚本上线记录 (近7天) -- =========================================== SELECT \'脚本上线-近7天\' AS \'统计类型\', DATE(created_at) as \'日期\', COUNT(*) as \'数量\'\nFROM  app_sh_release\nWHERE\n  created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND deleted_at IS NULL\n  AND status = 2\nGROUP BY  DATE(created_at)\nORDER BY  DATE(created_at) DESC; -- 查看所有脚本上线记录（包括不符合条件的） SELECT \'所有脚本上线记录\' AS \'类型\', id, title, status, CASE status\n    WHEN 1 THEN \'流程进行中\'\n    WHEN 2 THEN \'执行成功\'\n    WHEN 3 THEN \'执行失败\'\n    WHEN 4 THEN \'已驳回\'\n    WHEN 5 THEN \'已取消\'\n  END AS \'状态文本\', DATE(created_at) as \'日期\', created_at AS \'创建时间\', deleted_at AS \'删除时间\'\nFROM  app_sh_release\nWHERE  created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY  created_at DESC\nLIMIT  10; -- =========================================== -- 2. 检查快速发布记录 (近7天) -- =========================================== SELECT \'快速发布-近7天\' AS \'统计类型\', DATE(created_at) as \'日期\', COUNT(*) as \'数量\'\nFROM  quick_deployments\nWHERE\n  created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND status = 3\nGROUP BY  DATE(created_at)\nORDER BY  DATE(created_at) DESC; -- 查看所有快速发布记录（包括不符合条件的） SELECT \'所有快速发布记录\' AS \'类型\', id, title, status, CASE status\n    WHEN 1 THEN \'待发布\'\n    WHEN 2 THEN \'发布中\'\n    WHEN 3 THEN \'发布成功\'\n    WHEN 4 THEN \'发布失败\'\n    WHEN 5 THEN \'已取消\'\n  END AS \'状态文本\', DATE(created_at) as \'日期\', created_at AS \'创建时间\'\nFROM  quick_deployments\nWHERE  created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY  created_at DESC\nLIMIT  10; -- =========================================== -- 3. 检查服务上线记录 (近7天) -- =========================================== SELECT \'服务上线-近7天\' AS \'统计类型\', DATE(created_at) as \'日期\', COUNT(*) as \'数量\'\nFROM  app_service_release\nWHERE\n  created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND deleted_at IS NULL\n  AND status = 2\nGROUP BY  DATE(created_at)\nORDER BY  DATE(created_at) DESC; -- 查看所有服务上线记录（包括不符合条件的） SELECT \'所有服务上线记录\' AS \'类型\', id, title, status, CASE status\n    WHEN 1 THEN \'流程进行中\'\n    WHEN 2 THEN \'发布成功\'\n    WHEN 3 THEN \'发布失败\'\n    WHEN 4 THEN \'已驳回\'\n    WHEN 5 THEN \'已取消\'\n  END AS \'状态文本\', DATE(created_at) as \'日期\', created_at AS \'创建时间\', deleted_at AS \'删除时间\'\nFROM  app_service_release\nWHERE  created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY  created_at DESC\nLIMIT  10; -- =========================================== -- 4. 查看当前时间和时区 -- =========================================== SELECT NOW() AS \'当前时间\', CURDATE() AS \'当前日期\', @@system_time_zone AS \'系统时区\', @@session.time_zone AS \'会话时区\'; -- =========================================== -- 5. 测试你提到的两条记录 -- =========================================== -- 检查 2025-12-25 11:36:31 的脚本发布 SELECT \'你的脚本发布记录\' AS \'类型\', id, title, status, DATE(created_at) as \'日期\', created_at AS \'创建时间\', deleted_at AS \'删除时间\', CASE WHEN status = 2 AND deleted_at IS NULL THEN \'✅ 应该被统计\'\n    WHEN status != 2 THEN \'❌ 状态不符合(需要status=2)\'\n    WHEN deleted_at IS NOT NULL THEN \'❌ 已被软删除\'\n  END AS \'是否统计\'\nFROM  app_sh_release\nWHERE\n  created_at >= \'2025-12-25 11:36:00\'\n  AND created_at <= \'2025-12-25 11:37:00\'\nORDER BY  created_at DESC; -- 检查 2025-12-25 11:57:45 的快速发布 SELECT \'你的快速发布记录\' AS \'类型\', id, title, status, DATE(created_at) as \'日期\', created_at AS \'创建时间\', CASE WHEN status = 3 THEN \'✅ 应该被统计\'\n    WHEN status != 3 THEN CONCAT(\'❌ 状态不符合(当前status=\', status, \', 需要status=3)\')\n  END AS \'是否统计\'\nFROM  quick_deployments\nWHERE\n  created_at >= \'2025-12-25 11:57:00\'\n  AND created_at <= \'2025-12-25 11:58:00\'\nORDER BY  created_at DESC;', '', '', 2, 'Error 1064 (42000): You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near \'FROM  app_sh_release\nWHERE\n  created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n \' at line 2', 202, '2025-12-25 12:11:10.622', '', 0);
INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (482, 1, 'gin-api', 'app_sh_release', 5, '-- 上线趋势统计调试SQL\n-- 用于排查为什么最新的发布记录没有被统计到\n\n-- ===========================================\n-- 1. 检查脚本上线记录 (近7天)\n-- ===========================================\nSELECT\n    \'脚本上线-近7天\' AS `统计类型`,\n    DATE(created_at) as `日期`,\n    COUNT(*) as `数量`\nFROM app_sh_release\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND deleted_at IS NULL\n  AND status = 2\nGROUP BY DATE(created_at)\nORDER BY DATE(created_at) DESC;\n\n-- 查看所有脚本上线记录（包括不符合条件的）\nSELECT\n    \'所有脚本上线记录\' AS `类型`,\n    id,\n    title,\n    status,\n    CASE status\n        WHEN 1 THEN \'流程进行中\'\n        WHEN 2 THEN \'执行成功\'\n        WHEN 3 THEN \'执行失败\'\n        WHEN 4 THEN \'已驳回\'\n        WHEN 5 THEN \'已取消\'\n    END AS `状态文本`,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`,\n    deleted_at AS `删除时间`\nFROM app_sh_release\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY created_at DESC\nLIMIT 10;\n\n-- ===========================================\n-- 2. 检查快速发布记录 (近7天)\n-- ===========================================\nSELECT\n    \'快速发布-近7天\' AS `统计类型`,\n    DATE(created_at) as `日期`,\n    COUNT(*) as `数量`\nFROM quick_deployments\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND status = 3\nGROUP BY DATE(created_at)\nORDER BY DATE(created_at) DESC;\n\n-- 查看所有快速发布记录（包括不符合条件的）\nSELECT\n    \'所有快速发布记录\' AS `类型`,\n    id,\n    title,\n    status,\n    CASE status\n        WHEN 1 THEN \'待发布\'\n        WHEN 2 THEN \'发布中\'\n        WHEN 3 THEN \'发布成功\'\n        WHEN 4 THEN \'发布失败\'\n        WHEN 5 THEN \'已取消\'\n    END AS `状态文本`,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`\nFROM quick_deployments\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY created_at DESC\nLIMIT 10;\n\n-- ===========================================\n-- 3. 检查服务上线记录 (近7天)\n-- ===========================================\nSELECT\n    \'服务上线-近7天\' AS `统计类型`,\n    DATE(created_at) as `日期`,\n    COUNT(*) as `数量`\nFROM app_service_release\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND deleted_at IS NULL\n  AND status = 2\nGROUP BY DATE(created_at)\nORDER BY DATE(created_at) DESC;\n\n-- 查看所有服务上线记录（包括不符合条件的）\nSELECT\n    \'所有服务上线记录\' AS `类型`,\n    id,\n    title,\n    status,\n    CASE status\n        WHEN 1 THEN \'流程进行中\'\n        WHEN 2 THEN \'发布成功\'\n        WHEN 3 THEN \'发布失败\'\n        WHEN 4 THEN \'已驳回\'\n        WHEN 5 THEN \'已取消\'\n    END AS `状态文本`,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`,\n    deleted_at AS `删除时间`\nFROM app_service_release\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY created_at DESC\nLIMIT 10;\n\n-- ===========================================\n-- 4. 查看当前时间和时区\n-- ===========================================\nSELECT\n    NOW() AS `当前时间`,\n    CURDATE() AS `当前日期`,\n    @@system_time_zone AS `系统时区`,\n    @@session.time_zone AS `会话时区`;\n\n-- ===========================================\n-- 5. 测试你提到的两条记录\n-- ===========================================\n-- 检查 2025-12-25 11:36:31 的脚本发布\nSELECT\n    \'你的脚本发布记录\' AS `类型`,\n    id,\n    title,\n    status,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`,\n    deleted_at AS `删除时间`,\n    CASE\n        WHEN status = 2 AND deleted_at IS NULL THEN \'✅ 应该被统计\'\n        WHEN status != 2 THEN \'❌ 状态不符合(需要status=2)\'\n        WHEN deleted_at IS NOT NULL THEN \'❌ 已被软删除\'\n    END AS `是否统计`\nFROM app_sh_release\nWHERE created_at >= \'2025-12-25 11:36:00\'\n  AND created_at <= \'2025-12-25 11:37:00\'\nORDER BY created_at DESC;\n\n-- 检查 2025-12-25 11:57:45 的快速发布\nSELECT\n    \'你的快速发布记录\' AS `类型`,\n    id,\n    title,\n    status,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`,\n    CASE\n        WHEN status = 3 THEN \'✅ 应该被统计\'\n        WHEN status != 3 THEN CONCAT(\'❌ 状态不符合(当前status=\', status, \', 需要status=3)\')\n    END AS `是否统计`\nFROM quick_deployments\nWHERE created_at >= \'2025-12-25 11:57:00\'\n  AND created_at <= \'2025-12-25 11:58:00\'\nORDER BY created_at DESC;', '', '', 2, 'Error 1064 (42000): You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near \'SELECT\n    \'所有脚本上线记录\' AS `类型`,\n    id,\n    title,\n    status\' at line 20', 213, '2025-12-25 12:13:32.454', '', 0);
INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (483, 1, 'gin-api', 'app_sh_release', 1, '-- 上线趋势统计调试SQL\n-- 用于排查为什么最新的发布记录没有被统计到\n\n-- ===========================================\n-- 1. 检查脚本上线记录 (近7天)\n-- ===========================================\nSELECT\n    \'脚本上线-近7天\' AS `统计类型`,\n    DATE(created_at) as `日期`,\n    COUNT(*) as `数量`\nFROM app_sh_release\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND deleted_at IS NULL\n  AND status = 2\nGROUP BY DATE(created_at)\nORDER BY DATE(created_at) DESC;\n\n-- 查看所有脚本上线记录（包括不符合条件的）\nSELECT\n    \'所有脚本上线记录\' AS `类型`,\n    id,\n    title,\n    status,\n    CASE status\n        WHEN 1 THEN \'流程进行中\'\n        WHEN 2 THEN \'执行成功\'\n        WHEN 3 THEN \'执行失败\'\n        WHEN 4 THEN \'已驳回\'\n        WHEN 5 THEN \'已取消\'\n    END AS `状态文本`,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`,\n    deleted_at AS `删除时间`\nFROM app_sh_release\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY created_at DESC\nLIMIT 10;\n\n-- ===========================================\n-- 2. 检查快速发布记录 (近7天)\n-- ===========================================\nSELECT\n    \'快速发布-近7天\' AS `统计类型`,\n    DATE(created_at) as `日期`,\n    COUNT(*) as `数量`\nFROM quick_deployments\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND status = 3\nGROUP BY DATE(created_at)\nORDER BY DATE(created_at) DESC;\n\n-- 查看所有快速发布记录（包括不符合条件的）\nSELECT\n    \'所有快速发布记录\' AS `类型`,\n    id,\n    title,\n    status,\n    CASE status\n        WHEN 1 THEN \'待发布\'\n        WHEN 2 THEN \'发布中\'\n        WHEN 3 THEN \'发布成功\'\n        WHEN 4 THEN \'发布失败\'\n        WHEN 5 THEN \'已取消\'\n    END AS `状态文本`,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`\nFROM quick_deployments\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY created_at DESC\nLIMIT 10;\n\n-- ===========================================\n-- 3. 检查服务上线记录 (近7天)\n-- ===========================================\nSELECT\n    \'服务上线-近7天\' AS `统计类型`,\n    DATE(created_at) as `日期`,\n    COUNT(*) as `数量`\nFROM app_service_release\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\n  AND created_at < DATE_ADD(CURDATE(), INTERVAL 1 DAY)\n  AND deleted_at IS NULL\n  AND status = 2\nGROUP BY DATE(created_at)\nORDER BY DATE(created_at) DESC;\n\n-- 查看所有服务上线记录（包括不符合条件的）\nSELECT\n    \'所有服务上线记录\' AS `类型`,\n    id,\n    title,\n    status,\n    CASE status\n        WHEN 1 THEN \'流程进行中\'\n        WHEN 2 THEN \'发布成功\'\n        WHEN 3 THEN \'发布失败\'\n        WHEN 4 THEN \'已驳回\'\n        WHEN 5 THEN \'已取消\'\n    END AS `状态文本`,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`,\n    deleted_at AS `删除时间`\nFROM app_service_release\nWHERE created_at >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)\nORDER BY created_at DESC\nLIMIT 10;\n\n-- ===========================================\n-- 4. 查看当前时间和时区\n-- ===========================================\nSELECT\n    NOW() AS `当前时间`,\n    CURDATE() AS `当前日期`,\n    @@system_time_zone AS `系统时区`,\n    @@session.time_zone AS `会话时区`;\n\n-- ===========================================\n-- 5. 测试你提到的两条记录\n-- ===========================================\n-- 检查 2025-12-25 11:36:31 的脚本发布\nSELECT\n    \'你的脚本发布记录\' AS `类型`,\n    id,\n    title,\n    status,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`,\n    deleted_at AS `删除时间`,\n    CASE\n        WHEN status = 2 AND deleted_at IS NULL THEN \'✅ 应该被统计\'\n        WHEN status != 2 THEN \'❌ 状态不符合(需要status=2)\'\n        WHEN deleted_at IS NOT NULL THEN \'❌ 已被软删除\'\n    END AS `是否统计`\nFROM app_sh_release\nWHERE created_at >= \'2025-12-25 11:36:00\'\n  AND created_at <= \'2025-12-25 11:37:00\'\nORDER BY created_at DESC;\n\n-- 检查 2025-12-25 11:57:45 的快速发布\nSELECT\n    \'你的快速发布记录\' AS `类型`,\n    id,\n    title,\n    status,\n    DATE(created_at) as `日期`,\n    created_at AS `创建时间`,\n    CASE\n        WHEN status = 3 THEN \'✅ 应该被统计\'\n        WHEN status != 3 THEN CONCAT(\'❌ 状态不符合(当前status=\', status, \', 需要status=3)\')\n    END AS `是否统计`\nFROM quick_deployments\nWHERE created_at >= \'2025-12-25 11:57:00\'\n  AND created_at <= \'2025-12-25 11:58:00\'\nORDER BY created_at DESC;', '', '', 1, '执行成功', 1403, '2025-12-25 12:19:38.925', '', 0);
