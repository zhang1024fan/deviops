INSERT INTO `sys_activity_log` (`id`, `activity_type`, `title`, `content`, `status`, `related_id`, `summary`, `duration`, `create_time`) VALUES (12, 1, 'devops云主机批量同步', '[2025-12-28 01:53:00] 开始同步\n\nAWS云:\n  - AWS云: 暂未实现\n\n阿里云:\n  - test[阿里云]: 获取379台，新增379台，跳过0台，失败0台 [cn-shenzhen:2台 cn-hongkong:3台 us-east-1:2台 cn-qingdao:25台 cn-beijing:6台 cn-hangzhou:341台 ]\n  - 张三-阿里云-密钥[阿里云]: 获取1台，新增1台，跳过0台，失败0台 [cn-wulanchabu:1台 ]\n\n腾讯云:\n  - 腾讯云批量主机[腾讯云]: 获取82台，新增82台，跳过0台，失败0台 [ap-singapore:20台 na-siliconvalley:17台 ap-guangzhou:43台 ap-hongkong:1台 ap-tokyo:1台 ]\n\n华为云:\n  - 张三-华为云-密钥[华为云]: 获取1台，新增1台，跳过0台，失败0台 [cn-south-1:1台 ]\n\n百度云:\n  - 张三-百度云-密钥[百度云]: 获取1台，新增1台，跳过0台，失败0台 [bj:1台 ]\n本次同步 464 台新增主机，6 个密钥，共计耗时 4m9.844549966s\n[2025-12-28 01:57:09] 同步完成\n', 1, 8, '同步6个密钥，共计新增464台主机，耗时249.8秒', 249, '2025-12-28 01:57:10.160');
