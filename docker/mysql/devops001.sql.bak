INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (530, 1, 'gin-api', 'monitor_notify_robot', 1, '-- 更新飞书\nUPDATE monitor_notify_robot \nSET template = \'【{{if .IsRecovered}}警告{{else}}警告{{end}}】${rule_name}{{if .IsRecovered}}告警恢复 ✨✨✨{{else}}告警 🔥 🔥 🔥{{end}}\n【策略】: ${policy_name}\n【规则】: ${rule_name}\n【目标】: ${target_name}\n【指标】: ${metric_name}\n【当前值】: ${current_value}\n【阈值】: ${threshold}\n【时间】: ${first_trigger_time_format}\n【描述】: ${rule_name}\'\nWHERE type = \'feishu\';\n\n-- 更新钉钉\nUPDATE monitor_notify_robot \nSET template = \'### {{if .IsRecovered}}✅ 告警恢复{{else}}🔥 告警通知{{end}}\n\n**【${severity}】${rule_name}**\n\n---\n\n- **策略**: ${policy_name}\n- **规则**: ${rule_name}\n- **目标**: ${target_name}\n- **指标**: ${metric_name}\n- **当前值**: ${current_value}\n- **阈值**: ${threshold}\n- **时间**: ${first_trigger_time_format}\n{{if .IsRecovered}}- **恢复时间**: ${first_trigger_time_format}{{end}}\n\n---\n\n> ${rule_name}\'\nWHERE type = \'dingtalk\';\n\n-- 更新企业微信\nUPDATE monitor_notify_robot \nSET template = \'### {{if .IsRecovered}}<font color=\"info\">✅ 告警恢复</font>{{else}}<font color=\"warning\">🔥 告警通知</font>{{end}}\n\n**【${severity}】${rule_name}**\n\n---\n\n> **策略**: ${policy_name}\n> **规则**: ${rule_name}\n> **目标**: ${target_name}\n> **指标**: ${metric_name}\n> **当前值**: <font color=\"warning\">${current_value}</font>\n> **阈值**: ${threshold}\n> **时间**: ${first_trigger_time_format}\n{{if .IsRecovered}}> **恢复时间**: ${first_trigger_time_format}{{end}}\n\n---\n\n<font color=\"comment\">${rule_name}</font>\'\nWHERE type = \'wechat\';', '', '', 1, '执行成功', 149, '2026-01-29 18:17:30.873', '', 0);
INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (531, 1, 'gin-api', 'monitor_notify_robot', 1, 'SELECT id, name, type, template FROM monitor_notify_robot WHERE type IN (\'feishu\', \'dingtalk\', \'wechat\');', '', '', 1, '执行成功', 285, '2026-01-29 18:17:40.666', '', 0);
INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (532, 1, 'gin-api', 'monitor_notify_robot', 3, 'UPDATE monitor_notify_robot \nSET template = \'【{{if .IsRecovered}}警告{{else}}警告{{end}}】${rule_name}{{if .IsRecovered}}告警恢复 ✨✨✨{{else}}告警 🔥 🔥 🔥{{end}}\n【策略】: ${policy_name}\n【规则】: ${rule_name}\n【目标】: ${target_name}\n【指标】: ${metric_name}\n【当前值】: ${current_value}\n【阈值】: ${threshold}\n【时间】: ${first_trigger_time_format}\n【描述】: ${rule_name}\'\nWHERE type = \'feishu\';', '', '', 1, '执行成功', 211, '2026-01-29 18:18:01.863', '', 0);
INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (533, 1, 'gin-api', 'monitor_notify_robot', 3, 'UPDATE monitor_notify_robot \nSET template = \'### {{if .IsRecovered}}✅ 告警恢复{{else}}🔥 告警通知{{end}}\n\n**【${severity}】${rule_name}**\n\n---\n\n- **策略**: ${policy_name}\n- **规则**: ${rule_name}\n- **目标**: ${target_name}\n- **指标**: ${metric_name}\n- **当前值**: ${current_value}\n- **阈值**: ${threshold}\n- **时间**: ${first_trigger_time_format}\n{{if .IsRecovered}}- **恢复时间**: ${first_trigger_time_format}{{end}}\n\n---\n\n> ${rule_name}\'\nWHERE type = \'dingtalk\';', '', '', 1, '执行成功', 203, '2026-01-29 18:18:26.398', '', 0);
INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (534, 1, 'gin-api', 'monitor_notify_robot', 3, 'UPDATE monitor_notify_robot \nSET template = \'### {{if .IsRecovered}}<font color=\"info\">✅ 告警恢复</font>{{else}}<font color=\"warning\">🔥 告警通知</font>{{end}}\n\n**【${severity}】${rule_name}**\n\n---\n\n> **策略**: ${policy_name}\n> **规则**: ${rule_name}\n> **目标**: ${target_name}\n> **指标**: ${metric_name}\n> **当前值**: <font color=\"warning\">${current_value}</font>\n> **阈值**: ${threshold}\n> **时间**: ${first_trigger_time_format}\n{{if .IsRecovered}}> **恢复时间**: ${first_trigger_time_format}{{end}}\n\n---\n\n<font color=\"comment\">${rule_name}</font>\'\nWHERE type = \'wechat\';', '', '', 1, '执行成功', 207, '2026-01-29 18:18:44.931', '', 0);
INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (535, 1, 'gin-api', 'monitor_notify_robot', 1, 'SELECT * FROM monitor_notify_robot LIMIT 20 OFFSET 0', '', '', 1, '执行成功', 268, '2026-01-29 18:18:50.865', '', 0);
