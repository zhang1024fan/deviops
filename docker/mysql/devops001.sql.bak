-- ----------------------------
-- Table structure for monitor_api_monitor
-- ----------------------------
DROP TABLE IF EXISTS `monitor_api_monitor`;
CREATE TABLE `monitor_api_monitor` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(200) NOT NULL COMMENT '监控名称',
  `description` varchar(500) DEFAULT NULL COMMENT '描述',
  `group_id` bigint DEFAULT NULL COMMENT '业务组ID',
  `group_name` varchar(100) DEFAULT NULL COMMENT '业务组名称',
  `service_name` varchar(100) DEFAULT NULL COMMENT '服务名称(可选,用于进一步分类)',
  `url` varchar(1000) NOT NULL COMMENT '接口地址',
  `method` varchar(10) DEFAULT 'GET' COMMENT 'HTTP方法',
  `headers` text COMMENT '请求头(JSON)',
  `body` text COMMENT '请求体',
  `timeout` bigint DEFAULT '5000' COMMENT '超时时间(毫秒)',
  `expected_status` bigint DEFAULT '200' COMMENT '期望状态码',
  `expected_keyword` varchar(500) DEFAULT NULL COMMENT '期望响应关键字',
  `validate_json` text COMMENT 'JSON校验规则',
  `check_interval` bigint DEFAULT '60' COMMENT '检测间隔(秒)',
  `retry_count` bigint DEFAULT '3' COMMENT '失败重试次数',
  `alert_enabled` tinyint DEFAULT '1' COMMENT '是否启用告警',
  `policy_id` bigint DEFAULT NULL COMMENT '关联告警策略ID',
  `status` tinyint DEFAULT '1' COMMENT '启用状态(1:启用,0:禁用)',
  `health_status` varchar(20) DEFAULT 'unknown' COMMENT '健康状态(healthy/unhealthy/unknown)',
  `last_check_time` datetime(3) DEFAULT NULL COMMENT '最近检测时间',
  `last_response_time` bigint DEFAULT NULL COMMENT '最近响应时间(毫秒)',
  `last_status_code` bigint DEFAULT NULL COMMENT '最近状态码',
  `last_error_message` varchar(1000) DEFAULT NULL COMMENT '最近错误信息',
  `continuous_failures` bigint DEFAULT '0' COMMENT '连续失败次数',
  `tags` text COMMENT '标签(JSON数组)',
  `created_by` varchar(100) DEFAULT NULL COMMENT '创建人',
  `updated_by` varchar(100) DEFAULT NULL COMMENT '更新人',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  `business_function_id` bigint DEFAULT NULL COMMENT '业务功能ID',
  `business_function_name` varchar(200) DEFAULT NULL COMMENT '业务功能名称',
  `parent_id` bigint unsigned DEFAULT NULL COMMENT '父监控ID,用于实现分层关系',
  `hierarchy_level` bigint DEFAULT '0' COMMENT '层级深度: 0=独立监控, 1=一级子监控, 2=二级子监控',
  `is_aggregate` tinyint DEFAULT '0' COMMENT '是否为聚合监控(基于子监控结果计算)',
  PRIMARY KEY (`id`),
  KEY `idx_monitor_api_monitor_group_id` (`group_id`),
  KEY `idx_monitor_api_monitor_service_name` (`service_name`),
  KEY `idx_monitor_api_monitor_status` (`status`),
  KEY `idx_monitor_api_monitor_business_function_id` (`business_function_id`),
  KEY `idx_monitor_api_monitor_parent_id` (`parent_id`)
) ENGINE=InnoDB AUTO_INCREMENT=13 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_api_monitor
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for monitor_api_monitor_result
-- ----------------------------
DROP TABLE IF EXISTS `monitor_api_monitor_result`;
CREATE TABLE `monitor_api_monitor_result` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `monitor_id` bigint NOT NULL COMMENT '监控配置ID',
  `check_time` datetime(3) NOT NULL COMMENT '检测时间',
  `success` tinyint NOT NULL COMMENT '是否成功',
  `status_code` bigint DEFAULT NULL COMMENT 'HTTP状态码',
  `response_time` bigint DEFAULT NULL COMMENT '响应时间(毫秒)',
  `error_message` varchar(1000) DEFAULT NULL COMMENT '错误信息',
  `response_body` text COMMENT '响应内容',
  PRIMARY KEY (`id`),
  KEY `idx_monitor_api_monitor_result_monitor_id` (`monitor_id`),
  KEY `idx_monitor_api_monitor_result_check_time` (`check_time`)
) ENGINE=InnoDB AUTO_INCREMENT=3137 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_api_monitor_result
-- ----------------------------
BEGIN;
