INSERT INTO `sys_activity_log` (`id`, `activity_type`, `title`, `content`, `status`, `related_id`, `summary`, `duration`, `create_time`) VALUES (4, 1, 'cmdb云资产同步', '[2025-12-27 10:34:00] 开始同步\n\n阿里云:\n  - 张帆-阿里云-密钥[阿里云]: 同步失败 - 同步失败: 所有实例均已导入，无新增实例\n\n华为云:\n  - 张帆-华为云-密钥[华为云]: 获取1台，新增1台，跳过0台，失败0台 [cn-south-1:1台 ]\n\n百度云:\n  - 张帆-百度云-密钥[百度云]: 获取1台，新增1台，跳过0台，失败0台 [bj:1台 ]\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n本次同步 2 台新增主机，3 个密钥，共计耗时 54.232414686s\n[2025-12-27 10:34:54] 同步完成\n', 1, 7, '同步3个密钥，新增2台主机', 54232, '2025-12-27 10:34:54.566');
