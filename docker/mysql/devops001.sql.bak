SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ----------------------------
-- Table structure for ai_agent_chat_history
-- ----------------------------
DROP TABLE IF EXISTS `ai_agent_chat_history`;
CREATE TABLE `ai_agent_chat_history` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '''主键''',
  `session_id` varchar(64) NOT NULL COMMENT '''会话ID''',
  `user_id` bigint unsigned NOT NULL COMMENT '''用户ID''',
  `role` varchar(20) NOT NULL COMMENT '''角色:user/assistant/system''',
  `message` text NOT NULL COMMENT '''消息内容''',
  `intent` varchar(50) DEFAULT NULL COMMENT '''识别的意图类型''',
  `intent_conf` decimal(3,2) DEFAULT NULL COMMENT '''意图识别置信度''',
  `entities` json DEFAULT NULL COMMENT '''提取的实体(JSON)''',
  `task_id` bigint unsigned DEFAULT NULL COMMENT '''关联的任务ID''',
  `task_type` varchar(50) DEFAULT NULL COMMENT '''任务类型''',
  `status` tinyint DEFAULT '1' COMMENT '''状态:1=处理中,2=成功,3=失败''',
  `error_msg` text COMMENT '''错误信息''',
  `create_time` datetime(3) NOT NULL COMMENT '''创建时间''',
  PRIMARY KEY (`id`),
  KEY `idx_ai_agent_chat_history_session_id` (`session_id`),
  KEY `idx_ai_agent_chat_history_user_id` (`user_id`),
  KEY `idx_ai_agent_chat_history_task_id` (`task_id`)
) ENGINE=InnoDB AUTO_INCREMENT=332 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of ai_agent_chat_history
-- ----------------------------
BEGIN;
