INSERT INTO `db_sql_exec` (`id`, `db_id`, `db_name`, `table_name`, `type`, `sql`, `old_value`, `remark`, `status`, `res`, `exec_time`, `create_time`, `creator`, `creator_id`) VALUES (525, 1, 'gin-api', 'monitor_notify_robot', 3, 'UPDATE monitor_notify_robot \nSET template = \'【{{if .IsRecovered}}恢复通知{{else}}告警通知{{end}}】${alert_title}\n\n规则名称：${rule_name}\n报警指纹：${fingerprint}\n报警等级：${severity}\n报警主机：${target_name}\n容器名称：${labels.pod}\n业务环境：${labels.namespace}\n开始时间：${first_trigger_time_format}\n值班人员：${duty_user}\n详情：http://localhost:3000/faultCenter/detail/${faultCenterId}\'\nWHERE type = \'feishu\';', '', '', 1, '执行成功', 541, '2026-01-29 18:09:01.763', '', 0);
