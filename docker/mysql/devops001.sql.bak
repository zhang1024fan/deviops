-- ----------------------------
-- Table structure for monitor_alert_source
-- ----------------------------
DROP TABLE IF EXISTS `monitor_alert_source`;
CREATE TABLE `monitor_alert_source` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '''主键''',
  `name` longtext NOT NULL COMMENT '''告警源名称''',
  `type` bigint NOT NULL COMMENT '''告警源类型(1=flashduty,2=zabbix,3=n9e)''',
  `app_key` longtext NOT NULL COMMENT '''应用密钥''',
  `api_base_url` longtext COMMENT '''API基础URL''',
  `status` bigint DEFAULT '1' COMMENT '''状态(0=禁用,1=启用)''',
  `remark` text COMMENT '''备注''',
  `create_time` bigint DEFAULT NULL COMMENT '''创建时间''',
  `update_time` bigint DEFAULT NULL COMMENT '''更新时间''',
  `key_id` bigint unsigned DEFAULT '0' COMMENT '''云账号ID''',
  `host_id` bigint unsigned DEFAULT '0' COMMENT '''主机ID''',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=7 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_alert_source
-- ----------------------------
BEGIN;
INSERT INTO `monitor_alert_source` (`id`, `name`, `type`, `app_key`, `api_base_url`, `status`, `remark`, `create_time`, `update_time`, `key_id`, `host_id`) VALUES (4, 'aws账单', 4, '', '', 1, '123', 1766417563, 1766422399, 11, 0);
INSERT INTO `monitor_alert_source` (`id`, `name`, `type`, `app_key`, `api_base_url`, `status`, `remark`, `create_time`, `update_time`, `key_id`, `host_id`) VALUES (5, '阿里云账单', 2, '', '', 1, '123', 1766417864, 1774323327, 13, 0);
INSERT INTO `monitor_alert_source` (`id`, `name`, `type`, `app_key`, `api_base_url`, `status`, `remark`, `create_time`, `update_time`, `key_id`, `host_id`) VALUES (6, '平台主机', 5, '', '', 1, 'ops', 1766596721, 1774165038, 0, 722);
COMMIT;

-- ----------------------------
-- Table structure for monitor_aliyun_config
-- ----------------------------
DROP TABLE IF EXISTS `monitor_aliyun_config`;
CREATE TABLE `monitor_aliyun_config` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '''主键''',
  `name` longtext NOT NULL COMMENT '''配置名称''',
  `access_key` longtext NOT NULL COMMENT '''AccessKey''',
  `access_secret` longtext NOT NULL COMMENT '''AccessSecret''',
  `region` varchar(191) DEFAULT 'cn-hangzhou' COMMENT '''区域''',
  `email` longtext COMMENT '''联系邮箱''',
  `phone` longtext COMMENT '''联系电话''',
  `username` longtext COMMENT '''联系人姓名''',
  `status` bigint DEFAULT '1' COMMENT '''状态:1->启用,0->禁用''',
  `create_time` datetime(3) NOT NULL COMMENT '''创建时间''',
  `update_time` datetime(3) DEFAULT NULL COMMENT '''更新时间''',
  `eab_kid` longtext COMMENT '''ACME EAB Key ID (ZeroSSL等需要)''',
  `eab_hmac_key` longtext COMMENT '''ACME EAB HMAC Key (ZeroSSL等需要)''',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

-- ----------------------------
-- Records of monitor_aliyun_config
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for monitor_api_business_function
-- ----------------------------
DROP TABLE IF EXISTS `monitor_api_business_function`;
CREATE TABLE `monitor_api_business_function` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(200) NOT NULL COMMENT '业务功能名称',
  `description` varchar(500) DEFAULT NULL COMMENT '描述',
  `group_id` bigint NOT NULL COMMENT '业务组ID',
  `group_name` varchar(100) DEFAULT NULL COMMENT '业务组名称',
  `sort` bigint DEFAULT '0' COMMENT '排序',
  `status` tinyint DEFAULT '1' COMMENT '启用状态(1:启用,0:禁用)',
  `created_by` varchar(100) DEFAULT NULL COMMENT '创建人',
  `updated_by` varchar(100) DEFAULT NULL COMMENT '更新人',
  `created_at` datetime(3) DEFAULT NULL,
  `updated_at` datetime(3) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_monitor_api_business_function_group_id` (`group_id`),
  KEY `idx_monitor_api_business_function_status` (`status`)
) ENGINE=InnoDB AUTO_INCREMENT=8 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

